{
  "manifest_version": 3,
  "name": "Slate 登录助手",
  "version": "0.4.2",
  "description": "在你自己的浏览器登录 Boss直聘 / 猎聘 并核查天眼查公司背景，把会话 Cookie 与抓取结果交给 Slate 职位聚合搜索（仅本人本机使用，不外传）。",
  "permissions": ["cookies", "tabs", "declarativeNetRequest", "scripting"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "slate_cn_origin",
        "enabled": true,
        "path": "dnr-rules.json"
      }
    ]
  },
  "host_permissions": [
    "*://*.zhipin.com/*",      "*://zhipin.com/*",
    "*://*.liepin.com/*",      "*://liepin.com/*",
    "*://*.tianyancha.com/*",  "*://tianyancha.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*",
        "https://slate-jobs.fly.dev/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
