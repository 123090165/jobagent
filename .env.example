# Provider selection for profile-review evaluation and other LLM-backed flows.
JOBAGENT_LLM_PROVIDER=mock
JOBAGENT_LLM_TIMEOUT=300
JOBAGENT_LLM_TEMPERATURE=0

# Local Ollama OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_NUM_CTX=8192

# DeepSeek OpenAI-compatible endpoint.
# Do not commit a real DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional generic OpenAI-compatible fallback used by existing helpers.
JOBAGENT_LLM_API_KEY=
JOBAGENT_LLM_BASE_URL=https://api.openai.com/v1
JOBAGENT_LLM_MODEL=gpt-4o-mini

# Default backend-native job search provider.
# Search Preview can also select supported multi-source and browser-helper paths.
# Keep backend-only provider configuration on the server; never expose it to the frontend.
JOBAGENT_JOB_SEARCH_PROVIDER=cuhksz_career

# Comma-separated local web or Chrome extension origins allowed to call FastAPI.
# For unpacked Chrome extensions, add the stable origin after loading it, e.g.
# chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
JOBAGENT_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Username/password auth session lifetime in hours.
JOBAGENT_AUTH_SESSION_HOURS=336

# Optional Streamable HTTP MCP search server for interview learning resources.
# The configured tool should return structured results containing title and url/link.
JOBAGENT_LEARNING_MCP_URL=
JOBAGENT_LEARNING_MCP_TOOL=search
JOBAGENT_LEARNING_MCP_QUERY_ARGUMENT=query

# Optional Modular RAG MCP sidecar. Career Assistant uses it for bounded semantic
# discovery over the authenticated user's ready Resume Profiles and Saved Jobs.
JOBAGENT_RAG_MCP_URL=
JOBAGENT_RAG_MCP_TIMEOUT_SECONDS=10
JOBAGENT_RAG_MCP_MAX_RESPONSE_CHARS=500000

# Private resource synchronization uses authenticated internal management routes
# on the same RAG service. Keep disabled until RAG_SERVICE_TOKEN matches.
JOBAGENT_RAG_SYNC_ENABLED=false
JOBAGENT_RAG_MANAGEMENT_URL=http://127.0.0.1:8002
JOBAGENT_RAG_SERVICE_TOKEN=
JOBAGENT_RAG_MANAGEMENT_TIMEOUT_SECONDS=15
JOBAGENT_RAG_WORKER_POLL_SECONDS=2
JOBAGENT_RAG_WORKER_MAX_IDLE_SECONDS=30

# Optional durable LangGraph checkpoint database for guided preparation.
# Defaults beside JOBAGENT_DB_PATH when omitted.
JOBAGENT_LANGGRAPH_DB_PATH=

# Separate OpenAI-compatible model used only by persona-centered evaluations.
# Keep this different from the application generation model when possible.
JOBAGENT_EVAL_API_KEY=
JOBAGENT_EVAL_BASE_URL=https://api.openai.com/v1
JOBAGENT_EVAL_MODEL=
JOBAGENT_EVAL_TIMEOUT=180
JOBAGENT_EVAL_TEMPERATURE=0.2

# Optional Langfuse tracing for evaluation cost and latency analysis.
# Content is redacted by default; only context sizes, usage, stages, and IDs are sent.
JOBAGENT_LANGFUSE_ENABLED=false
JOBAGENT_LANGFUSE_CAPTURE_CONTENT=false
JOBAGENT_LANGFUSE_HASH_SALT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_RELEASE=

# Local Tavily-backed learning-search MCP server. Never commit the real key.
TAVILY_API_KEY=
JOBAGENT_LEARNING_MCP_HOST=127.0.0.1
JOBAGENT_LEARNING_MCP_PORT=8001
TAVILY_TIMEOUT_SECONDS=15
