# Provider selection for profile-review evaluation and other LLM-backed flows.
JOBAGENT_LLM_PROVIDER=mock
JOBAGENT_LLM_TIMEOUT=300
JOBAGENT_LLM_TEMPERATURE=0

# Local Ollama OpenAI-compatible endpoint.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_NUM_CTX=8192

# DeepSeek OpenAI-compatible endpoint.
# Do not commit a real DEEPSEEK_API_KEY.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Optional generic OpenAI-compatible fallback used by existing helpers.
JOBAGENT_LLM_API_KEY=
JOBAGENT_LLM_BASE_URL=https://api.openai.com/v1
JOBAGENT_LLM_MODEL=gpt-4o-mini
